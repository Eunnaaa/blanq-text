{
  "name": "text-based-media-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "High-performance text-based social media with Threads + GitHub ATM design system",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "yarn workspace @repo/web dev",
    "build:web": "yarn workspace @repo/web build",
    "db:generate": "yarn workspace @repo/database db:generate",
    "db:migrate": "yarn workspace @repo/database db:migrate",
    "db:studio": "yarn workspace @repo/database db:studio"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
